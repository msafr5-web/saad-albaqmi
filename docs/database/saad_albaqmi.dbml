  net_halalas bigint [note: 'generated: ((round((quantity * (unit_price_halalas)::numeric)))::bigint - discount_halalas)']
  vat_halalas bigint [note: 'generated: (round((((((round((quantity * (unit_price_halalas)::numeric)))::bigint - discount_halalas))::numeric * vat_rate) / (100)::numeric)))::bigint']
  Note: 'بنود فواتير المبيعات، والضريبة والصافي مولَّدان'
}

Table sales_invoices {
