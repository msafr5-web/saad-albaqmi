  created_at timestamptz [not null, default: `now()`]
  Note: 'الترسية؛ تتطلب ثلاثة عروض، ومبررًا إن لم تكن الأقل سعرًا'
}

Table rfq_suppliers {
  rfq_id bigint
  supplier_id bigint
  sent_at timestamptz
  declined_at timestamptz
  indexes { (rfq_id, supplier_id) [pk] }
  Note: 'الموردون المدعوون لكل طلب عروض'
}

Table rfqs {
  id bigint [pk, increment]
