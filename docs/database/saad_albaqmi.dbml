Table payroll_lines {
  id bigint [pk, increment]
  run_id bigint [not null]
  employee_id bigint [not null]
  basic_halalas bigint [not null]
  allowances_halalas bigint [not null, default: `0`]
  deductions_halalas bigint [not null, default: `0`]
  net_halalas bigint [note: 'generated: ((basic_halalas + allowances_halalas) - deductions_halalas)']
  days_worked numeric(5,2)
  Note: 'بنود الرواتب لكل موظف؛ تُقفل بعد اعتماد الدورة'
}

Table payroll_runs {
  id bigint [pk, increment]
  branch_id bigint [not null]
  period_month date [not null]
  status text [not null, default: `'draft'::text`]
  approved_by int
  approved_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  Note: 'دورات الرواتب الشهرية لكل فرع (مسودة، معتمدة، مصروفة)'
}

Table presence_events {
  id bigint [pk, increment]
  card_id bigint
  holder_type text [not null]
  holder_id bigint [not null]
  branch_id bigint [not null]
  event_type text [not null]
  room_id bigint
  session_id bigint
  method text [not null]
  device_member_id int
  verified bool [not null, default: `false`]
  ip inet
  occurred_at timestamptz [not null, default: `now()`]
  Note: 'حركات الدخول والخروج وحضور القاعات والحصص'
}

Table procurement_exceptions {
  id bigint [pk, increment]
  pr_id bigint [not null]
  exception_type text [not null]
  reason text [not null]
  requested_by int [not null]
  approved_by int
  approved_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  Note: 'استثناءات قاعدة الثلاثة عروض والشراء المباشر بسبب مكتوب واعتماد'
}

Table purchase_limits {
  id bigint [pk, increment]
  branch_id bigint
  period text [not null]
  max_amount_halalas bigint [not null]
  valid_from date [not null]
  valid_to date
  set_by int [not null]
  Note: 'سقوف الشراء الأسبوعية والشهرية (من المدير العام)'
}

Table purchase_order_lines {
  id bigint [pk, increment]
  po_id bigint [not null]
  line_no int [not null]
  item_id bigint [not null]
  description text
  quantity numeric(14,3) [not null]
  unit_price_halalas bigint [not null]
  vat_rate numeric(6,3) [not null, default: `15`]
  net_halalas bigint [note: 'generated: (round((quantity * (unit_price_halalas)::numeric)))::bigint']
  vat_halalas bigint [note: 'generated: (round(((round((quantity * (unit_price_halalas)::numeric)) * vat_rate) / (100)::numeric)))::bigint']
  Note: 'بنود أمر الشراء'
}

Table purchase_orders {
  id bigint [pk, increment]
  po_no text [not null]
  version int [not null, default: `1`]
  supersedes_po_id bigint
  pr_id bigint [not null]
  rfq_id bigint
  exception_id bigint
  branch_id bigint [not null]
  warehouse_id bigint [not null]
  supplier_id bigint [not null]
  entity_name text [not null]
  entity_vat_number text [not null]
  supplier_vat_number text [not null]
  issue_date date [not null]
  delivery_date date
  terms text
  status text [not null, default: `'draft'::text`]
  net_halalas bigint [not null, default: `0`]
  vat_halalas bigint [not null, default: `0`]
  gross_halalas bigint [note: 'generated: (net_halalas + vat_halalas)']
  prepared_by int [not null]
  prepared_at timestamptz
  approved_by int
  approved_at timestamptz
  approved_via_delegation_id bigint
  sent_at timestamptz
  acknowledged_at timestamptz
  document_hash text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'أوامر الشراء باسم الجهة؛ تتجمد بعد التجهيز، ولا يعتمدها من أعدّها'
}

Table purchase_request_lines {
  id bigint [pk, increment]
  pr_id bigint [not null]
  item_id bigint [not null]
  qty numeric(14,3) [not null]
  notes text
  Note: 'أصناف وكميات طلب الشراء'
}

Table purchase_requests {
  id bigint [pk, increment]
  pr_no text [not null, unique]
  branch_id bigint [not null]
  warehouse_id bigint [not null]
  path text [not null, default: `'standard'::text`]
  source text [not null, default: `'manual'::text`]
  alert_id bigint
  reason text
  status text [not null, default: `'draft'::text`]
  requested_by int [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'طلبات الشراء، من تنبيه المخزون أو يدويًا'
}

Table quotation_evaluations {
  id bigint [pk, increment]
  quotation_id bigint [not null]
  evaluated_by int [not null]
  technical_score int [not null]
  quality_score int [not null]
  commercial_score int [not null]
  notes text
  created_at timestamptz [not null, default: `now()`]
  Note: 'تقييم العروض فنيًا وجودةً وماليًا'
}

Table quotation_lines {
  id bigint [pk, increment]
  quotation_id bigint [not null]
  item_id bigint [not null]
  quantity numeric(14,3) [not null]
  unit_price_halalas bigint [not null]
  vat_rate numeric(6,3) [not null, default: `15`]
  net_halalas bigint [note: 'generated: (round((quantity * (unit_price_halalas)::numeric)))::bigint']
  vat_halalas bigint [note: 'generated: (round(((round((quantity * (unit_price_halalas)::numeric)) * vat_rate) / (100)::numeric)))::bigint']
  Note: 'أسعار بنود العرض، والصافي والضريبة مولَّدان'
}

Table quotations {
  id bigint [pk, increment]
