  zatca_status text [not null, default: `'not_submitted'::text`]
  zatca_hash text
  created_by int
  created_at timestamptz [not null, default: `now()`]
  Note: 'فواتير المبيعات (قياسية أو مبسطة) بحقول جاهزة للفوترة الإلكترونية'
}

Table session_recurrences {
