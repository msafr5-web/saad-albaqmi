# Copy to .env (never commit real values). Names only; see docs/security.md for what each one does.

# --- Database -------------------------------------------------------------------------------------------------
DATABASE_URL=postgres://saad:saad_dev_password@localhost:5432/saad_albaqmi
# Only for `pnpm --filter @workspace/db run create-db` (a role with CREATEDB on any existing database)
ADMIN_DATABASE_URL=postgres://saad:saad_dev_password@localhost:5432/postgres
DB_POOL_MAX=5
DB_STATEMENT_TIMEOUT_MS=15000

# --- Identity (Clerk) -----------------------------------------------------------------------------------------
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PROXY_URL=
ORG_OWNER_EMAIL=

# --- Email (Resend): team invitations and OTP codes -------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
APP_PUBLIC_URL=

# --- OTP confirmation of financial operations --------------------------------------------------------------------
# Turn on ONLY after the migrations are applied, email works and the web app shows the confirmation dialog.
OTP_FINANCE_REQUIRED=false
# At least 32 random characters, e.g. `openssl rand -hex 32`. Rotating it invalidates pending codes only.
OTP_HMAC_SECRET=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- HTTP hardening ----------------------------------------------------------------------------------------------
# Extra trusted browser origins (comma separated). Empty = same-origin only.
CORS_ALLOWED_ORIGINS=
TRUST_PROXY_HOPS=1
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_WRITES_PER_MINUTE=60
PERSONAL_RECORD_LIMIT=2000
