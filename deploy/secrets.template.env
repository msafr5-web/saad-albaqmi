# =====================================================================================================================
#  ملف الأسرار والإعدادات المطلوبة للنشر على الخادم (قالب).
#
#  الاستخدام:
#    1) node deploy/generate-secrets.mjs        -> ينشئ deploy/secrets.env ويملأ الأسرار العشوائية تلقائيًا
#    2) افتح deploy/secrets.env واملأ القيم الفارغة المعلَّمة (REQUIRED) فقط
#    3) انسخه إلى الخادم بـ scp (لا ترسله في محادثة ولا ترفعه إلى GitHub: المستودع عام!)
#
#  deploy/secrets.env مُدرج في .gitignore. لا تضع كلمة مرور root هنا؛ استخدم مفتاح SSH.
# =====================================================================================================================

# ---------- الخادم ----------
SERVER_HOST=2.24.60.36
SERVER_USER=root
# مسار مفتاح SSH الخاص على جهازك (الموصى به بدل كلمة المرور). مثال: C:/Users/you/.ssh/id_ed25519
SSH_KEY_PATH=Xc&eCmaf?9Ca1w5y
# اسم النطاق الموجّه إلى 2.24.60.36 (سجل A). REQUIRED لتشغيل HTTPS؛ بدونه لن تعمل بوابة الدخول (Clerk) ولا قراءة NFC.
DOMAIN=
# بريد لتنبيهات شهادة Let's Encrypt
LETSENCRYPT_EMAIL=
# الفرع الذي يُنشر (main بعد الدمج)
GIT_BRANCH=main

# ---------- قاعدة البيانات (PostgreSQL على نفس الخادم) ----------
DB_NAME=saad_albaqmi
DB_USER=saad
# يُولَّد تلقائيًا (16 بايت عشوائية)
DB_PASSWORD=

# ---------- الدخول والهوية (Clerk) — REQUIRED ----------
# من لوحة Clerk (clerk.com) > API Keys. استخدم نسخة Production مع سجلات DNS التي تطلبها Clerk لنطاقك.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
# اتركه فارغًا على نطاقك الخاص
VITE_CLERK_PROXY_URL=
# بريد المالك: أول مدير أعلى. يجب أن يكون موثَّقًا في Clerk. REQUIRED
ORG_OWNER_EMAIL=

# ---------- البريد (Resend) — للدعوات ورموز OTP وأوامر الشراء ----------
RESEND_API_KEY=
# عنوان مُرسِل من نطاق موثَّق في Resend، مثال: صرح البقمي <no-reply@yourdomain.com>
RESEND_FROM_EMAIL=

# ---------- أسرار التطبيق (تُولَّد تلقائيًا؛ لا تغيّرها بعد الاستخدام) ----------
# 32+ حرفًا. تغيير OTP_HMAC_SECRET يبطل الرموز المعلّقة فقط.
OTP_HMAC_SECRET=
# تغيير CARD_HMAC_SECRET يبطل علامات القاعات المطبوعة.
CARD_HMAC_SECRET=

# ---------- مفاتيح التشغيل ----------
# اتركه false حتى تجرّب نافذة OTP والبريد، ثم غيّره إلى true.
OTP_FINANCE_REQUIRED=false
# قفل الفرع الذي تنشره بنسخة قديمة من تغيير الأدوار غير مطلوب؛ الحدود أدناه افتراضية آمنة.
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_WRITES_PER_MINUTE=60
PERSONAL_RECORD_LIMIT=2000

# --- E-mail sign-in codes (organization mailbox, Hostinger) ---
# SMTP_PASSWORD: the password of the mailbox SMTP_USER. Fill it in, then ask Claude to apply it (it goes to /etc/saad-albaqmi/api.env on the server).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=dr.saad@drsaad.tech
SMTP_FROM=dr.saad@drsaad.tech
SMTP_PASSWORD=
