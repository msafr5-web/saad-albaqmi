{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/api-server exec node build-vercel.mjs && PORT=3000 BASE_PATH=/ NODE_ENV=production pnpm --filter @workspace/saad-albaqmi run build",
  "outputDirectory": "artifacts/saad-albaqmi/dist/public",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "artifacts/api-server/dist/vercel.mjs",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.mjs" },
    { "source": "/((?!api/|assets/|brand/|icons/).*)", "destination": "/index.html" }
  ]
}
